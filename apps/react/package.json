{
  "name": "@harborline-software/app-react-web",
  "version": "0.1.0-preview.1",
  "private": true,
  "description": "Harborline App React web application",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "feed": "node scripts/build-local-feed.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test:preview": "pnpm build && node --test scripts/preview-host.test.mjs",
    "typecheck": "tsc -b --noEmit",
    "test": "node --test ../shared/tests/*.test.mjs && vitest run"
  },
  "dependencies": {
    "@harborline-software/contracts": "file:.feed/contracts",
    "@harborline-software/ui-react": "file:.feed/ui-react",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.6",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "jsdom": "29.1.1",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "packageManager": "pnpm@11.1.3",
  "justifications": {
    "@harborline-software/contracts": "workspace",
    "@harborline-software/ui-react": "workspace",
    "react": "R-0080",
    "react-dom": "R-0080",
    "@testing-library/jest-dom": "R-0083",
    "@testing-library/react": "R-0083",
    "@testing-library/user-event": "R-0083",
    "@types/node": "R-0086",
    "@types/react": "R-0086",
    "@types/react-dom": "R-0086",
    "@vitejs/plugin-react": "R-0083",
    "jsdom": "R-0083",
    "typescript": "R-0086",
    "vite": "R-0086",
    "vitest": "R-0083"
  }
}
