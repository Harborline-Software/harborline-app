@using Harborline.UIAdapters.Blazor.Components.Layout
@using Harborline.App.Blazor.ReferenceHost.Admin.Forms
@using Harborline.App.Blazor.ReferenceHost.Admin.Reports
@using Harborline.App.Blazor.ReferenceHost.Admin.Views
@using Harborline.App.Blazor.ReferenceHost.Admin.DataExchange
@using Harborline.App.Blazor.ReferenceHost.Admin.Scheduling
@using Harborline.App.Blazor.ReferenceHost.Admin.Authorization
@using Harborline.Contracts.Authorization
@inject IAuthorizationAdminClient AuthorizationClient
@using Harborline.App.Blazor.ReferenceHost.Navigation
@using Harborline.App.Blazor.ReferenceHost.Workshop
@using Harborline.UIAdapters.Blazor.Components.DataDisplay
@using System.Text.Json
@using Microsoft.AspNetCore.WebUtilities
@inject IPackNavigationClient PackNavigationClient
@inject NavigationManager BrowserNavigation
@implements IDisposable

@* Composed from the platform's hlp.ui.app-shell module rather than hand-written chrome. This
   lives in its own component because it must be INTERACTIVE: the shell resolves railCapable from
   a JS media-query subscription after first render, so under static server rendering the rail
   never appears at all. App.razor is the document and cannot itself carry a render mode.

   Navigation is ACTIVATION-DRIVEN, not href-driven, and deliberately mirrors
   apps/react/src/App.tsx exactly: same workspace, same item ids, same labels, same body response
   to selection, same Pilot-panel placeholder behind the header sparkle action. Two lanes of one
   app must not disagree about whether navigation routes or activates. *@
@if (navigationError is not null)
{
    <section role="alert"><p>@navigationError</p><button type="button" @onclick="LoadNavigationAsync">Retry navigation</button></section>
}
<HarborlineAppShell @key="@(packNavigation is not null)" ShellId="harborline-app"
                  BrandText="Harborline"
                  Navigation="@(packNavigation ?? Navigation)"
                  NavigationState="@NavigationState"
                  ResolveLabel="@ResolveLabel"
                  RoleVocabulary="@roleVocabulary"
                  HeldRoles="@HeldRoles"
                  DefaultActiveWorkspaceId="@ActiveWorkspace?.Id"
                  ActiveItemId="@activeItemId"
                  Navigated="@NavigateAsync"
                  InspectorCommand="@OpenInspectorAsync"
                  PageHeader="@PageHeaderFragment"
                  OpenPanelIds="@OpenPanelIds"
                  OpenPanelIdsChanged="@SetOpenPanelIdsAsync"
                  PanelToolbar="@PanelToolbar"
                  PanelContent="@PanelContent">
    @if (activeItemId == "access.holders")
    {
        <main class="happ-page"><AccessHoldersPage /></main>
    }
    else if (activeItemId == "admin-forms")
    {
        <main class="happ-page">
            <FormsAdminPage />
        </main>
    }
    else if (activeItemId == "admin-reports")
    {
        <main class="happ-page">
            <ReportsAdminPage />
        </main>
    }
    else if (activeItemId == "admin-views")
    {
        <main class="happ-page">
            <ViewsAdminPage />
        </main>
    }
    else if (activeItemId == "admin-data-exchange")
    {
        <main class="happ-page">
            <DataExchangeAdminPage />
        </main>
    }
    else if (activeItemId == "admin-scheduling")
    {
        <main class="happ-page">
            <SchedulingAdminPage />
        </main>
    }
    else if (activeItemId == "admin-authorization")
    {
        <main class="happ-page">
            <AuthorizationAdminPage />
        </main>
    }
    else if (WorkshopItems.Contains(activeItemId))
    {
        <main class="happ-page"><h1>@ActiveLabel</h1><SeededListPage ItemId="@activeItemId" SelectedRowId="@selectedRowId" RowActivated="@SelectDefinitionAsync" SelectionRestored="@(row => selectedDefinition = row)" /></main>
    }
    else
    {
        <main class="happ-page">
            <h1>@ActiveLabel</h1>
            <p>@ActiveDescription</p>
        </main>
    }
</HarborlineAppShell>

@code {
    private static string ResolveLabel(string key) => key switch
    {
        "panels.inspector" => "Inspector", "panels.inspector.footerClaim" => "Follows selection",
        "access.workspace" => "Access", "access.holders" => "Holders",
        "access.details" or "access.details.footer" => "Access details",
        "workshop.workspace" => "Workshop", "workshop.definitions" => "Definitions",
        _ when key.StartsWith("workshop.", StringComparison.Ordinal)
            && WorkshopLabels.TryGetValue(key["workshop.".Length..], out var label) => label,
        _ => key,
    };
    private static readonly IReadOnlyDictionary<string, string> WorkshopLabels = new Dictionary<string, string>
    {
        ["asset-types"] = "Record types", ["forms"] = "Forms", ["workflows"] = "Workflows", ["standards"] = "Standards",
        ["defaults"] = "Defaults", ["terminology"] = "Terminology", ["documents"] = "Documents", ["taxonomies"] = "Taxonomies",
        ["reports"] = "Reports", ["data-exchanges"] = "Data exchanges", ["standing-rules"] = "Standing rules",
        ["schedules"] = "Schedules", ["views"] = "Views",
    };
    private static readonly IReadOnlySet<string> WorkshopItems = WorkshopLabels.Keys.ToHashSet();
    private static readonly IReadOnlyList<ShellNavItem> NavigationItems =
    [
        new ShellNavItem("assets", "Assets"),
        new ShellNavItem("run-report", "Run report"),
        new ShellNavItem("admin-forms", "Forms"),
        new ShellNavItem("admin-reports", "Reports"),
        new ShellNavItem("admin-views", "Views"),
        new ShellNavItem("admin-data-exchange", "Data Exchange"),
        new ShellNavItem("admin-scheduling", "Scheduling"),
        // Ticket 205 will gate this item from live scoped held roles. No existing admin item has
        // that server/session role snapshot yet, so the API route fence remains authoritative.
        new ShellNavItem("admin-authorization", "Settings"),
    ];
    private static readonly PackNavigationDeclaration Navigation = new(
        [new("portfolio", "Portfolio", Groups: [new("portfolio-group", "Portfolio", NavigationItems.Select(item => item.Id).ToArray())])],
        PanelSet: [new("pilot", "panels.pilot.toggle", "mod+shift+p", 400, 300, false, "Pilot")]);
    private static readonly ShellNavigationState NavigationState = new(
        Items: NavigationItems.ToDictionary(item => item.Id));

    private string activeItemId = "assets";
    private IReadOnlyList<string> openPanelIds = [];
    private string? selectedRowId;
    private ViewRuntimeRow? selectedDefinition;
    private PackNavigationDeclaration? packNavigation;
    private string? navigationError;
    private readonly CancellationTokenSource navigationCancellation = new();
    private RoleVocabulary roleVocabulary = RoleVocabulary.FromApi([]);
    private static readonly HeldRoleSet HeldRoles = new([]);
    private static readonly JsonSerializerOptions InspectorJsonOptions = new() { WriteIndented = true };

    private string ActiveLabel => activeItemId switch
    {
        "access.holders" => "Holders",
        "run-report" => "Run report",
        "admin-forms" => "Forms",
        "admin-reports" => "Reports",
        "admin-views" => "Views",
        "admin-data-exchange" => "Data Exchange",
        "admin-scheduling" => "Scheduling",
        "admin-authorization" => "Settings › System",
        "assets" => "Assets",
        _ when WorkshopLabels.TryGetValue(activeItemId, out var label) => label,
        _ => activeItemId,
    };
    private string ActiveDescription => activeItemId == "run-report"
        ? "Generate a report across the assets your organization tracks."
        : activeItemId == "assets" ? "Browse and manage the physical assets your organization tracks."
        : "This application surface is not available in this version.";

    private PackNavigationWorkspace? ActiveWorkspace => (packNavigation ?? Navigation).SeedWorkspaces
        .FirstOrDefault(workspace => workspace.Groups?.Any(group => group.ItemIds.Contains(activeItemId, StringComparer.Ordinal)) == true);
    private string? ContentWorkspaceLabel => ActiveWorkspace is { } workspace ? ResolveLabel(workspace.LabelKey) : activeItemId == "assets" ? "Portfolio" : null;
    private RenderFragment PageHeaderFragment => @<nav aria-label="Breadcrumb" class="happ-breadcrumb">Harborline / @(ContentWorkspaceLabel is { } label ? $"{label} / " : "")@ActiveLabel</nav>;
    private IReadOnlyList<string> OpenPanelIds => openPanelIds;
    private RenderFragment<PackPanelDeclaration> PanelToolbar => panel => @<span>
        @if (panel.Id == "inspector")
        {
            <p>@(selectedDefinition is null ? "No selection · follows selection" : $"{DisplayTitle(selectedDefinition)} · follows selection")</p>
        }
    </span>;
    private RenderFragment<PackPanelDeclaration> PanelContent => panel => @<section class="happ-pilot">
        @if (panel.Id == "inspector")
        {
            <section aria-label="Definition inspector">
                @if (selectedDefinition is null)
                {
                    <p>Select a Workshop definition to inspect it.</p>
                }
                else
                {
                    <h2>@DisplayTitle(selectedDefinition)</h2>
                    <pre>@JsonSerializer.Serialize(selectedDefinition.Values, InspectorJsonOptions)</pre>
                }
            </section>
        }
        else
        {
            <p>@(panel.Id == "pilot" ? $"Pilot sees what you see — Portfolio · {ActiveLabel}." : $"{ResolveLabel(panel.LabelKey ?? panel.Id)}: This application surface is not available in this version.")</p>
        }
    </section>;

    private async Task NavigateAsync(ShellNavItem item)
    {
        activeItemId = item.Id;
        selectedRowId = null;
        selectedDefinition = null;
        ReplaceAddress();
        await Task.CompletedTask;
    }

    private async Task SetOpenPanelIdsAsync(IReadOnlyList<string> ids)
    {
        openPanelIds = ids;
        ReplaceAddress();
        await Task.CompletedTask;
    }

    private async Task OpenInspectorAsync()
    {
        if (!DeclaredPanels().Contains("inspector", StringComparer.Ordinal)) return;
        if (!openPanelIds.Contains("inspector", StringComparer.Ordinal)) openPanelIds = [.. openPanelIds, "inspector"];
        ReplaceAddress();
        await Task.CompletedTask;
    }

    private async Task SelectDefinitionAsync(ViewRuntimeRow row)
    {
        selectedDefinition = row;
        selectedRowId = row.Id;
        await OpenInspectorAsync();
    }

    private async Task LoadNavigationAsync()
    {
        navigationError = null;
        try
        {
            packNavigation = await PackNavigationClient.ReadAsync(navigationCancellation.Token);
            var navigation = packNavigation ?? Navigation;
            var address = ReadAddress();
            openPanelIds = address.HasPanelState
                ? address.OpenPanelIds.Where(DeclaredPanels(navigation).Contains).ToArray()
                : navigation.PanelSet?.Where(panel => panel.DefaultOpen).Select(panel => panel.Id).ToArray() ?? [];
            activeItemId = address.ItemId is { } itemId && (itemId == "assets" || DeclaredItemIds(navigation).Contains(itemId, StringComparer.Ordinal))
                ? itemId : "assets";
            selectedRowId = WorkshopItems.Contains(activeItemId) ? address.SelectedRowId : null;
            selectedDefinition = null;
            if (address.ItemId is not null || address.SelectedRowId is not null || address.HasPanelState) ReplaceAddress();
        }
        catch (OperationCanceledException) when (navigationCancellation.IsCancellationRequested) { }
        catch (Exception exception) when (exception is HttpRequestException or InvalidOperationException or System.Text.Json.JsonException)
        {
            navigationError = "Unable to load application navigation. Retry the request.";
        }
    }

    public void Dispose()
    {
        navigationCancellation.Cancel();
        navigationCancellation.Dispose();
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadNavigationAsync();
        try
        {
            var rows = await AuthorizationClient.ListRoleVocabularyAsync();
            roleVocabulary = RoleVocabulary.FromApi(rows.Select(row => new Harborline.Contracts.Authorization.RoleDefinition(
                row.RoleDefinitionId,
                new Harborline.Contracts.Authorization.RoleReference(row.Role.Vocabulary, row.Role.Name),
                row.DisplayName,
                new Harborline.Contracts.Authorization.RoleOwner(
                    Enum.Parse<RoleOwnerKind>(row.Owner.Kind, ignoreCase: false),
                    row.Owner.OwnerId),
                row.IsSealed)));
        }
        catch (Exception exception) when (exception is AuthorizationAdminException or HttpRequestException or ArgumentException)
        {
            // Unknown or unavailable vocabulary fails every role-gated item closed. The Authorization
            // route itself remains server-fenced and its page owns the visible load/retry error.
            roleVocabulary = RoleVocabulary.FromApi([]);
        }
    }

    private IReadOnlyList<string> DeclaredPanels() => DeclaredPanels(packNavigation ?? Navigation);
    private static IReadOnlyList<string> DeclaredPanels(PackNavigationDeclaration navigation) => navigation.PanelSet?.Select(panel => panel.Id).ToArray() ?? [];
    private static IReadOnlyList<string> DeclaredItemIds(PackNavigationDeclaration navigation) => navigation.SeedWorkspaces
        .SelectMany(workspace => workspace.Groups ?? [])
        .SelectMany(group => group.ItemIds)
        .ToArray();
    private static string DisplayTitle(ViewRuntimeRow row)
    {
        var title = row.Values.TryGetValue("title", out var value) ? value?.ToString()?.Trim() : null;
        return string.IsNullOrEmpty(title) ? row.Id : title;
    }

    private sealed record ChromeAddress(string? ItemId, string? SelectedRowId, IReadOnlyList<string> OpenPanelIds, bool HasPanelState);

    private ChromeAddress ReadAddress()
    {
        var query = QueryHelpers.ParseQuery(BrowserNavigation.ToAbsoluteUri(BrowserNavigation.Uri).Query);
        return new(
            query.TryGetValue("item", out var item) ? item.ToString() : null,
            query.TryGetValue("selected", out var selected) ? selected.ToString() : null,
            query.TryGetValue("panels", out var panels) ? panels.ToString().Split(',', StringSplitOptions.RemoveEmptyEntries) : [],
            query.ContainsKey("panels"));
    }

    private void ReplaceAddress()
    {
        var uri = BrowserNavigation.ToAbsoluteUri(BrowserNavigation.Uri);
        var retained = QueryHelpers.ParseQuery(uri.Query)
            .Where(pair => pair.Key is not ("item" or "selected" or "panels"))
            .SelectMany(pair => pair.Value, (pair, value) => $"{Uri.EscapeDataString(pair.Key)}={Uri.EscapeDataString(value!)}")
            .ToList();
        retained.Add($"item={Uri.EscapeDataString(activeItemId)}");
        if (selectedRowId is not null) retained.Add($"selected={Uri.EscapeDataString(selectedRowId)}");
        if (openPanelIds.Count > 0) retained.Add($"panels={Uri.EscapeDataString(string.Join(',', openPanelIds))}");
        var target = new Uri($"{uri.GetLeftPart(UriPartial.Path)}?{string.Join('&', retained)}{uri.Fragment}");
        if (Uri.Compare(uri, target, UriComponents.AbsoluteUri, UriFormat.UriEscaped, StringComparison.Ordinal) == 0) return;
        BrowserNavigation.NavigateTo(target.AbsoluteUri, replace: true);
    }
}
