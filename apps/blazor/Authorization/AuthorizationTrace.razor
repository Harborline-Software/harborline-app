@namespace Harborline.App.Blazor.ReferenceHost.Authorization

<details @ontoggle="LoadAsync">
    <summary>Why can I do this?</summary>
    @if (Decision is null)
    {
        <p>A recorded decision is not linked to this result.</p>
    }
    else
    {
        @if (loading) { <p role="status">Loading authorization trace…</p> }
        @if (error is not null) { <p role="alert">@error</p> }
        @if (result?.Availability == 2)
        {
            <p role="alert">You do not have permission to read this authorization trace.</p>
        }
        else if (result?.Availability == 1)
        {
            <p>No authorization trace was recorded for this decision.</p>
        }
        else if (result is not null && (!Valid || result.Availability != 0))
        {
            <p role="alert">The recorded authorization trace is incomplete or unsupported.</p>
        }
        else if (result is not null)
        {
            <ol aria-label="Authorization trace">
                @for (var index = 0; index < result.Steps.Count; index++)
                {
                    var step = result.Steps[index];
                    <li>
                        <h4>@Labels[index]</h4>
                        @foreach (var fact in step.Facts) { <p style="overflow-wrap:anywhere">@fact</p> }
                        @if (index == 3) { <p>Deciding grant: @Deciding</p> }
                    </li>
                }
            </ol>
        }
        @if (!loading && (error is not null || result?.Availability == 2))
        {
            <button type="button" @onclick="RetryAsync">Retry trace read</button>
        }
    }
</details>

@code {
    [Parameter] public RecordedDecision? Decision { get; set; }
    private static readonly string[] Stages = ["act", "effective-roles", "standings", "verdict"];
    private static readonly string[] Labels = ["Act kind", "Roles in force for the subject with scope and dates", "Standings", "Verdict"];
    private AuthorizationTraceRead? result;
    private string? error;
    private bool loading;
    private bool Valid => result is { Version: 1, Steps.Count: 4 }
        && result.Steps.Select((step, index) => step.Ordinal == index + 1 && step.Stage == Stages[index]).All(value => value);
    private string Deciding => result?.Steps[1].Facts.FirstOrDefault(fact => fact.StartsWith("deciding:grant:", StringComparison.Ordinal))?[15..] ?? "None recorded";
    private async Task LoadAsync()
    {
        if (Decision is null || loading || result is not null || error is not null) return;
        loading = true;
        try { result = await Decision.Read(Decision.AuditId); }
        catch (Exception) { error = "Unable to read the authorization trace. Try again."; }
        finally { loading = false; }
    }
    private Task RetryAsync()
    {
        result = null;
        error = null;
        return LoadAsync();
    }
}
