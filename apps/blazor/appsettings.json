{
  // LocalNode:SessionToken is the per-boot bearer the node was started with
  // (env override: LocalNode__SessionToken). Every admin HTTP client presents it. Empty means
  // present nothing — correct only against a node running in un-enforced dev mode, because the
  // node's listener gate is gate-all-by-default and answers 401 otherwise.
  "LocalNode": {
    "SessionToken": ""
  },
  // FormsAdmin:BaseUrl activates the HTTP client (env override: FormsAdmin__BaseUrl).
  // Empty requires an explicit FormsAdmin:UseFixture=true opt-in (set for Development in
  // appsettings.Development.json); otherwise startup fails loudly — the fixture is never
  // a silent fallback (ticket 153).
  "FormsAdmin": {
    "BaseUrl": "",
    "UseFixture": false
  },
  // ReportsAdmin:BaseUrl activates the HTTP client (env override: ReportsAdmin__BaseUrl).
  // Empty means the fixture client — the app runs standalone by default.
  "ReportsAdmin": {
    "BaseUrl": ""
  },
  // ViewsAdmin:BaseUrl activates the HTTP client (env override: ViewsAdmin__BaseUrl).
  // Empty means the fixture client — the app runs standalone by default.
  "ViewsAdmin": {
    "BaseUrl": ""
  },
  // DataExchangeAdmin:BaseUrl activates the HTTP client (env override: DataExchangeAdmin__BaseUrl).
  // Empty means the fixture client — the app runs standalone by default.
  "DataExchangeAdmin": {
    "BaseUrl": ""
  },
  // SchedulingAdmin:BaseUrl activates the HTTP client (env override: SchedulingAdmin__BaseUrl).
  // Empty means the fixture client — the app runs standalone by default.
  "SchedulingAdmin": {
    "BaseUrl": ""
  }
}
