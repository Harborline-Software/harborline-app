<Project Sdk="Microsoft.NET.Sdk.Web">
  <ItemGroup>
    <!-- src/Harborline.App.Blazor was referenced here but never rendered: this host composes the
         platform's modules directly (see Shell.razor). An unused reference implies a dependency
         that does not exist. That package still has a consumer in tests/package-consumer. -->
    <!-- The platform UI package, consumed from the local feed in nuget.config. -->
    <PackageReference Include="Harborline.UIAdapters.Blazor" />
  </ItemGroup>
  <ItemGroup>
    <!-- T-460. The platform's RELEASED configuration activation Form (platform-package-ck-7),
         written into the local feed out of the pinned platform checkout by
         scripts/build-local-feed.mjs. Embedded rather than checked in so the definition this host
         ships cannot drift from eng/platform-pin.json. The feed is a build prerequisite here
         exactly as the packages in it are. -->
    <EmbeddedResource Include=".feed/platform/configuration-activation.json"
                      LogicalName="Harborline.App.Blazor.ReferenceHost.configuration-activation.json" />
    <Content Remove=".feed/**" />
  </ItemGroup>
</Project>
