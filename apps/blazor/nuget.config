<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- Local content-addressed feed. The app consumes the platform as a PACKAGE, never as a
         project reference: a project reference resolves static web assets from disk and would
         hide a package that carries no stylesheet - the exact defect this app shipped. -->
    <add key="harborline-local" value=".feed" />
  </packageSources>
</configuration>
