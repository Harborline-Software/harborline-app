@namespace Harborline.App.Blazor.ReferenceHost.Runtime
@using Harborline.UIAdapters.Blazor.Components.DataDisplay
@using Harborline.UIAdapters.Blazor.Components.Forms
@using Microsoft.JSInterop
@inject IJSRuntime Javascript
@inject Microsoft.Extensions.Options.IOptions<Microsoft.AspNetCore.Components.Server.CircuitOptions> CircuitOptions
@implements IAsyncDisposable

<section aria-label="Pack actions">
    @if (busy) { <p role="status">Working…</p> }
    @if (snapshot?.Plan is { } plan)
    {
        <HarborlineViewRuntime Plan="@plan" Rows="@snapshot.RuntimeRows" Empty="No rows."
            ActionsDisabled="@busy" OnRowActivate="@SelectAsync" OnAction="@BeginAsync" />
    }
    @if (snapshot?.SelectedId is { } selected) { <p role="status">Selected: @selected</p> }
    @if (snapshot?.ActiveAction is { } action)
    {
        <section aria-label="@action.Label">
            @if (snapshot.RequestDetails is { Count: > 0 } requestDetails)
            {
                <details><summary>Request details</summary>
                    <fieldset disabled="@(busy || snapshot.RequestLocked)"><legend>Request identifiers</legend>
                        @foreach (var detail in requestDetails)
                        {
                            <label>@(detail.Key == "id" ? "Request ID" : detail.Key == "idempotencyKey" ? "Idempotency key" : "Correlation ID")
                                <input name="@($"request.{detail.Key}")" value="@detail.Value"
                                    @onchange="@(args => SetRequestDetailAsync(detail.Key, args.Value?.ToString() ?? string.Empty))" />
                            </label>
                        }
                    </fieldset>
                    <button type="button" disabled="@busy" @onclick="NewRequestAsync">New request</button>
                </details>
            }
            @if (snapshot.Form is { } form)
            {
                <HarborlineSchemaForm @key="actionKey" View="@form" Values="@values" Disabled="@busy"
                    OnValuesChange="@(next => values = next)" Strings="@(new SchemaFormStrings { Submit = action.Label })" OnSubmit="@SubmitAsync" />
            }
            else
            {
                <fieldset disabled="@busy">
                    <legend>@action.Label</legend>
                    @if (action.FileInput is { } file)
                    {
                        <label>Package file <input @key="actionKey" @ref="fileElement" type="file" accept="@file.Accept" /></label>
                    }
                    <button type="button" @onclick="@InvokeAsync">@action.Label</button>
                </fieldset>
            }
        </section>
    }
    @if ((error ?? snapshot?.Error) is { } message)
    {
        <section role="alert"><p>@message</p><button type="button" disabled="@busy" @onclick="ReloadAsync">Reload view</button></section>
    }
    @if (snapshot?.Receipt is { } receipt)
    {
        <section aria-label="Action result" aria-live="polite">
            <p>@(receipt.Status is >= 200 and < 300 ? "Completed" : "Refused") (@receipt.Status)</p>
            @if (receipt.AuditId is { } audit) { <p>Audit: @audit</p> }
            @if (receipt.CorrelationId is { } correlation) { <p>Correlation: @correlation</p> }
            <pre>@receipt.Text</pre>
        </section>
    }
</section>

@code {
    [Parameter, EditorRequired] public string ViewId { get; set; } = string.Empty;
    [Parameter] public EventCallback NavigationChanged { get; set; }
    [Parameter] public CancellationToken CancellationToken { get; set; }
    private const string InteropFailure = "The selected-session request could not complete. No mutation was retried.";
    private readonly CancellationTokenSource lifetime = new();
    private IJSObjectReference? module;
    private IJSObjectReference? runtime;
    private PackActionSnapshot? snapshot;
    private IReadOnlyDictionary<string, object?> values = new Dictionary<string, object?>();
    private ElementReference fileElement;
    private string? attemptedView;
    private string? error;
    private bool busy;
    private bool disposed;
    private int actionKey;

    private CancellationTokenSource StartRequest(CancellationToken caller)
    {
        var request = CancellationTokenSource.CreateLinkedTokenSource(lifetime.Token, caller);
        // Passing a token to JS interop replaces its default timeout. Keep the configured
        // deadline, but distinguish it from cancellation actually owned by this host/caller.
        request.CancelAfter(CircuitOptions.Value.JSInteropDefaultCallTimeout);
        return request;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (attemptedView == ViewId || disposed) return;
        attemptedView = ViewId;
        await LoadViewAsync(recreate: true);
        if (!disposed) StateHasChanged();
    }

    private async Task LoadViewAsync(bool recreate)
    {
        var caller = CancellationToken;
        using var request = StartRequest(caller);
        busy = true; error = null;
        try
        {
            request.Token.ThrowIfCancellationRequested();
            if (recreate || runtime is null)
            {
                if (runtime is not null) { await runtime.InvokeVoidAsync("dispose"); await runtime.DisposeAsync(); runtime = null; }
                if (module is not null) { await module.DisposeAsync(); module = null; }
                snapshot = null;
                var imported = await Javascript.InvokeAsync<IJSObjectReference>("import", request.Token, "./pack-action-runtime.mjs");
                if (disposed) { await imported.DisposeAsync(); return; }
                module = imported;
                var created = await module.InvokeAsync<IJSObjectReference>("createPackActionRuntime", request.Token);
                if (disposed) { await created.InvokeVoidAsync("dispose"); await created.DisposeAsync(); return; }
                runtime = created;
            }
            var next = await runtime.InvokeAsync<PackActionSnapshot>("load", request.Token, ViewId);
            if (!disposed) snapshot = next;
        }
        catch (JSException) { error = InteropFailure; }
        catch (OperationCanceledException) when (!lifetime.IsCancellationRequested && !caller.IsCancellationRequested) { error = InteropFailure; }
        finally { busy = false; }
    }

    private async Task SelectAsync(string id)
    {
        if (disposed || runtime is null || busy) return;
        var caller = CancellationToken;
        using var request = StartRequest(caller);
        try { request.Token.ThrowIfCancellationRequested(); snapshot = await runtime.InvokeAsync<PackActionSnapshot>("select", request.Token, id); }
        catch (JSException) { error = InteropFailure; }
        catch (OperationCanceledException) when (!lifetime.IsCancellationRequested && !caller.IsCancellationRequested) { error = InteropFailure; }
    }

    private async Task ReloadAsync()
    {
        if (disposed || busy) return;
        await LoadViewAsync(recreate: runtime is null);
    }

    private async Task BeginAsync(string id)
    {
        if (disposed || runtime is null || busy) return;
        var caller = CancellationToken;
        using var request = StartRequest(caller);
        busy = true; error = null; values = new Dictionary<string, object?>(); actionKey++;
        try { request.Token.ThrowIfCancellationRequested(); snapshot = await runtime.InvokeAsync<PackActionSnapshot>("begin", request.Token, id); }
        catch (JSException) { error = InteropFailure; }
        catch (OperationCanceledException) when (!lifetime.IsCancellationRequested && !caller.IsCancellationRequested) { error = InteropFailure; }
        finally { busy = false; }
    }

    private async Task InvokeAsync()
    {
        if (disposed || runtime is null || busy) return;
        var caller = CancellationToken;
        using var request = StartRequest(caller);
        busy = true; error = null;
        var revision = snapshot?.NavigationRevision ?? 0;
        try { request.Token.ThrowIfCancellationRequested(); snapshot = snapshot?.ActiveAction?.FileInput is not null
            ? await runtime.InvokeAsync<PackActionSnapshot>("invokeWithFile", request.Token, values, fileElement)
            : await runtime.InvokeAsync<PackActionSnapshot>("invoke", request.Token, values);
            if (!disposed && snapshot.NavigationRevision != revision) await NavigationChanged.InvokeAsync(); }
        catch (JSException) { error = InteropFailure; }
        catch (OperationCanceledException) when (!lifetime.IsCancellationRequested && !caller.IsCancellationRequested) { error = InteropFailure; }
        finally { busy = false; }
    }

    private async Task SetRequestDetailAsync(string name, string value)
    {
        if (disposed || runtime is null || busy || snapshot?.RequestDetails is not { } details || snapshot.RequestLocked) return;
        var caller = CancellationToken;
        using var request = StartRequest(caller);
        var entries = details.Select(pair => new[] { pair.Key, pair.Key == name ? value : pair.Value }).ToArray();
        try { request.Token.ThrowIfCancellationRequested(); snapshot = await runtime.InvokeAsync<PackActionSnapshot>("setRequestDetails", request.Token, (object)entries); }
        catch (JSException) { error = InteropFailure; }
        catch (OperationCanceledException) when (!lifetime.IsCancellationRequested && !caller.IsCancellationRequested) { error = InteropFailure; }
    }

    private async Task NewRequestAsync()
    {
        if (disposed || runtime is null || busy) return;
        var caller = CancellationToken;
        using var request = StartRequest(caller);
        try { request.Token.ThrowIfCancellationRequested(); snapshot = await runtime.InvokeAsync<PackActionSnapshot>("newRequest", request.Token); }
        catch (JSException) { error = InteropFailure; }
        catch (OperationCanceledException) when (!lifetime.IsCancellationRequested && !caller.IsCancellationRequested) { error = InteropFailure; }
    }

    private async ValueTask<SchemaFormValidationResult?> SubmitAsync(IReadOnlyDictionary<string, object?> submitted)
    {
        values = submitted;
        await InvokeAsync();
        return null;
    }

    public async ValueTask DisposeAsync()
    {
        if (disposed) return;
        disposed = true;
        await lifetime.CancelAsync();
        try
        {
            if (runtime is not null) { await runtime.InvokeVoidAsync("dispose"); await runtime.DisposeAsync(); }
            if (module is not null) await module.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
        finally { lifetime.Dispose(); }
    }
}
