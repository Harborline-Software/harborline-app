@namespace Harborline.App.Blazor.ReferenceHost.Admin.Views
@using Microsoft.AspNetCore.Components
@using Harborline.UIAdapters.Blazor.Components.DataDisplay
@using Harborline.UIAdapters.Blazor.Components.Layout
@inject IViewsAdminClient Client

<h1>Views</h1>

@if (definitions is null)
{
    @if (loadError is null)
    {
        <p class="happ-muted">Loading…</p>
    }
    else
    {
        <p class="happ-error" role="alert">@loadError</p>
    }
}
else
{
    <HarborlineDataGrid TRow="ViewDefinitionSummary"
                      Rows="@definitions"
                      GetRowId="@(d => $"{d.Key}@{d.Version}")"
                      Columns="@columns"
                      Zebra="true"
                      AccessibleLabel="View definitions"
                      Empty="No view definitions for this tenant." />
}

@if (selected is not null)
{
    <HarborlineDetailPanel Label="@($"View definition {selected.Key}")"
                         Open="true"
                         OpenChanged="@CloseDetailAsync"
                         Width="420"
                         RailCapable="@PanelRailCapable">
        <ViewDefinitionDetailView Summary="selected"
                                    Detail="detail"
                                    History="history"
                                    ErrorLine="@detailError" />
    </HarborlineDetailPanel>
}

@code {
    private IReadOnlyList<ViewDefinitionSummary>? definitions;
    private string? loadError;
    private ViewDefinitionSummary? selected;
    private ViewDefinitionDetail? detail;
    private ViewVersionList? history;
    private string? detailError;

    private readonly IReadOnlyList<DataGridColumn<ViewDefinitionSummary>> columns;

    /// <summary>
    /// Gets or sets whether the detail panel may collapse to a rail.
    /// </summary>
    [Parameter]
    public bool? PanelRailCapable { get; set; }

    public ViewsAdminPage()
    {
        columns =
        [
            new DataGridColumn<ViewDefinitionSummary>(
                "key",
                "Key",
                d => d.Key,
                CellTemplate: row => @<button type="button" class="happ-link" @onclick="() => SelectAsync(row)">@row.Key</button>, RemovalPriority: 50),
            new DataGridColumn<ViewDefinitionSummary>("title", "Title", d => d.Title, RemovalPriority: 40),
            new DataGridColumn<ViewDefinitionSummary>("version", "Version", d => d.Version, RemovalPriority: 30),
            new DataGridColumn<ViewDefinitionSummary>("kind", "Kind", d => d.ViewKind, RemovalPriority: 20),
            new DataGridColumn<ViewDefinitionSummary>("cascadeLayer", "Cascade layer", d => d.CascadeLayer, RemovalPriority: 10),
        ];
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            definitions = await Client.ListDefinitionsAsync();
        }
        catch (ViewsAdminException exception)
        {
            loadError = exception.Message;
        }
    }

    private async Task SelectAsync(ViewDefinitionSummary row)
    {
        selected = row;
        detail = null;
        history = null;
        detailError = null;
        try
        {
            detail = await Client.GetDefinitionAsync(row.Key);
            history = await Client.ListVersionsAsync(row.Key);
        }
        catch (ViewsAdminException exception)
        {
            detailError = exception.Message;
        }
    }

    private Task CloseDetailAsync(bool open)
    {
        if (!open)
        {
            selected = null;
            detail = null;
            history = null;
            detailError = null;
        }

        return Task.CompletedTask;
    }
}
