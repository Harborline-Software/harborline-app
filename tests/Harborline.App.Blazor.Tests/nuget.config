<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- The transitive Harborline.UIAdapters.Blazor package restores from the app lane's local content-addressed feed. -->
    <add key="harborline-local" value="../../apps/blazor/.feed" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
