<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <HarborlinePackageVersion Condition="'$(HarborlinePackageVersion)' == ''">0.1.0-preview.1</HarborlinePackageVersion>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Harborline.App.Abstractions" Version="$(HarborlinePackageVersion)" />
    <PackageReference Include="Harborline.App.Blazor" Version="$(HarborlinePackageVersion)" />
    <PackageReference Include="Harborline.App.Blazor.Hybrid" Version="$(HarborlinePackageVersion)" />
    <PackageReference Include="Harborline.App.Testing" Version="$(HarborlinePackageVersion)" />
  </ItemGroup>
</Project>
